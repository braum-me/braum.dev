---
import { ClientRouter } from "astro:transitions";
import SEOSchema from "~/components/SEOSchema.astro";
import { env } from "~/lib/env.ts";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** "home" | "lab" | "404" — drives page-view tracking + OG-image selection */
  pageType?: "home" | "lab" | "404";
  /** Lab slug, only relevant when pageType === "lab" */
  labSlug?: string;
}

const {
  title = "Public Labs",
  description = "Experimente, Tools, halbfertige Ideen.",
  noindex = false,
  pageType = "home",
  labSlug,
} = Astro.props;

const siteUrl = (env("PUBLIC_SITE_URL") ?? Astro.site?.toString() ?? "https://braum.dev").replace(/\/+$/, "");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

// OG-image: pre-rendered PNG cards in /public/og/. Run `pnpm og:build` after
// editing card definitions in src/lib/og.ts. PNG (vs SVG) for universal
// crawler support — Twitter/X in particular doesn't render SVG og:image.
const ogImageSlug = pageType === "lab" && labSlug ? labSlug : "default";
const ogImageUrl = new URL(`/og/${ogImageSlug}.png`, siteUrl).toString();

const umamiScript = env("UMAMI_SCRIPT_URL");
const umamiWebsiteId = env("UMAMI_WEBSITE_ID");
const umamiEnabled = Boolean(umamiScript && umamiWebsiteId);

// Deterministic-ish ambient particles, generated server-side once.
const PARTICLE_COUNT = 26;
const seed = Math.floor(Date.now() / (1000 * 60 * 30));
let prng = seed || 1;
const rand = (): number => {
  prng = (prng * 1664525 + 1013904223) % 0xffffffff;
  return prng / 0xffffffff;
};

const particles = Array.from({ length: PARTICLE_COUNT }, () => {
  const tx = rand() * 100;
  const ty = rand() * 100;
  const dur = 22 + rand() * 26;
  const delay = -rand() * dur;
  const size = 1.2 + rand() * 1.6;
  const op = 0.18 + rand() * 0.5;
  const isMint = rand() < 0.18;
  return {
    tx: tx.toFixed(2),
    ty: ty.toFixed(2),
    dur: dur.toFixed(1),
    delay: delay.toFixed(1),
    size: size.toFixed(2),
    op: op.toFixed(2),
    isMint,
  };
});
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#051E16" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="de" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Braum Labs" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${title} – Braum Labs`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${title} – Braum Labs`} />

    <SEOSchema
      pageType={pageType}
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      siteUrl={siteUrl}
      labSlug={labSlug}
    />

    {
      umamiEnabled && (
        <script is:inline defer src={umamiScript} data-website-id={umamiWebsiteId} data-do-not-track="true" />
      )
    }
    <ClientRouter />
  </head>
  <body>
    <div class="atmosphere" aria-hidden="true" transition:persist transition:name="atmosphere">
      <div class="glow1"></div>
      <div class="glow2"></div>
      <div class="vignette"></div>
    </div>
    <div class="lab-grid-bg" aria-hidden="true" transition:persist transition:name="lab-grid"></div>
    <div class="atmosphere-particles" aria-hidden="true" transition:persist transition:name="particles">
      {
        particles.map((p) => (
          <span
            class:list={["particle", p.isMint && "mint"]}
            style={`--tx:${p.tx}%;--ty:${p.ty}%;--dur:${p.dur}s;--delay:${p.delay}s;--size:${p.size}px;--op:${p.op}`}
          />
        ))
      }
    </div>
    <div class="grain-fixed" aria-hidden="true" transition:persist transition:name="grain"></div>

    <main class="relative z-[1] min-h-screen" data-page-type={pageType} data-lab-slug={labSlug}>
      <slot />
    </main>

    <script>
      import "~/scripts/animations.client.ts";
    </script>
  </body>
</html>
